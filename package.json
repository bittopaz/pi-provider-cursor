{
  "name": "pi-provider-cursor",
  "version": "0.0.1",
  "description": "Pi provider for Cursor models: lists them, streams replies, and forwards Pi's tools",
  "author": "Xiaoyu Zhong (https://github.com/bittopaz)",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "cursor",
    "cursor-sdk",
    "ai",
    "extension"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bittopaz/pi-provider-cursor.git"
  },
  "bugs": {
    "url": "https://github.com/bittopaz/pi-provider-cursor/issues"
  },
  "homepage": "https://github.com/bittopaz/pi-provider-cursor#readme",
  "files": [
    "dist",
    "src",
    "scripts/build.mjs",
    "scripts/prepare.mjs",
    "tsconfig.build.json",
    "tsconfig.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    "./side-request": "./dist/cursor-side-request.js"
  },
  "engines": {
    "node": ">=24.22.3 <25 || >=26.13.1"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "prepare": "node ./scripts/prepare.mjs",
    "typecheck": "npm run typecheck:src && npm run typecheck:tests",
    "typecheck:src": "node ./node_modules/typescript/bin/tsc --noEmit",
    "typecheck:tests": "node ./node_modules/typescript/bin/tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cursor/sdk": "1.5.0",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
